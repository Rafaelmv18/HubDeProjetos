# Configurações do Hub de Projetos para o Docker Compose.
# Copie este arquivo para ".env" antes de subir o projeto: cp .env.example .env
# Os valores abaixo servem só para rodar na sua máquina. Nunca use em produção.

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_local_123

# Banco separado, usado só pelos testes automatizados (TDD)
POSTGRES_TEST_DB=hub_testes

# Novas variáveis entram aqui a cada etapa (Laravel, Reverb, LiveKit...)
